# MenuDock admin console — environment (Create React App reads REACT_APP_* at build time).
# Copy to .env.local and fill in. Uses the shared PLATFORM Firebase project — the same
# project the restaurant website and owner dashboard use.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Base domain used to build each restaurant's app links (website / loyalty / dashboard).
REACT_APP_PLATFORM_DOMAIN=menudock.app
